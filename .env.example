# Template. Copy this file to ".env" and fill in real values there.
# This file is committed to git. ".env" never is.

# Nebius Token Factory
NEBIUS_API_KEY=

# Confirm the base URL from the Token Factory docs once the account
# exists. Nebius AI Studio was renamed Token Factory, so a URL written
# from memory is a guess, and a wrong base URL fails as a confusing
# 404 rather than an obvious "bad URL" error.
NEBIUS_BASE_URL=

# Model ids per tier, filled in once the catalogue is confirmed.
NEMOTRON_NANO=
NEMOTRON_SUPER=
NEMOTRON_ULTRA=

# Tavily search
TAVILY_API_KEY=

# Telegram notifications.
# Token comes from @BotFather in Telegram. The chat id is discovered after
# you send the bot its first message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
